# ATELO — environment ($0 dev stack). Copy to .env.local and fill in.

# Supabase (PostgreSQL + magic-link auth + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini 1.5 Flash (native JSON output) — https://aistudio.google.com
GEMINI_API_KEY=

# Lemon Squeezy (Merchant of Record — credits + Pro subscription)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Public site URL (used to generate client board links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
